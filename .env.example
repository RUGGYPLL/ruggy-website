# Public application origins. Production must use HTTPS.
NEXT_PUBLIC_SITE_URL=https://ruggy.pl
NEXT_PUBLIC_APP_URL=https://ruggy.pl

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin authorization. Use UUIDs or emails, and keep this list small.
RUGGY_ADMIN_USER_IDS=
RUGGY_ADMIN_EMAILS=

# Dedicated HMAC secret for reference image proofs. Strongly recommended in production.
RUGGY_UPLOAD_SIGNING_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend order confirmations
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ruggy <zamowienia@ruggy.pl>
# Set only while testing. Remove from production.
RESEND_TEST_RECIPIENT=

# InPost Geowidget
NEXT_PUBLIC_INPOST_GEOWIDGET_TOKEN=
NEXT_PUBLIC_INPOST_GEOWIDGET_ENV=production

# OpenAI rug previews. OPENAI_KEY remains a legacy fallback in code.
OPENAI_API_KEY=

# Meta WhatsApp Cloud API quote notifications
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=48XXXXXXXXX
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_NAME=new_quote_request
WHATSAPP_PAID_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pl
